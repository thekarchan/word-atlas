# Copy to .env.local and adjust. Vite reads this from the repo root.

# Origin that serves illustrations, audio, brand art and UI sound.
# When unset, the app defaults to https://assets.hellokar.org.
VITE_ASSET_BASE=https://assets.hellokar.org

# Fully offline development: serve the local assets/ tree through the dev server.
# Requires `npm run assets:pull` first. Only works with `npm run dev`/`preview`.
# VITE_ASSET_BASE=/assets

# Deploy under a sub-path instead of the domain root (build-time only).
# ATLAS_BASE=/words/

# --- Cloudflare credentials, only needed for `npm run assets:sync` -----------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=word-atlas-assets
