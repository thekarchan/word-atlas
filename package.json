{
  "name": "word-atlas",
  "version": "1.0.0",
  "type": "module",
  "description": "A beautiful, open IELTS vocabulary atlas: 7,000+ illustrated words with UK/US audio, original examples and FSRS spaced repetition.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test \"web/src/**/*.test.ts\" \"worker/src/**/*.test.ts\"",
    "check:atlas": "node scripts/check-atlas.mjs",
    "build:atlas": "python3 scripts/atlas/build_atlas.py",
    "render:cards": "node scripts/render-cards.mjs",
    "pack:public": "python3 scripts/package_public.py --out ../开源发布/word-atlas",
    "assets:manifest": "node scripts/assets/manifest.mjs",
    "assets:sync": "node scripts/assets/sync-r2.mjs",
    "assets:pull": "bash scripts/assets/pull-media.sh",
    "format": "prettier --write web/src vite.config.ts scripts/*.mjs package.json tsconfig.json",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "test:worker": "node --import tsx --test \"worker/src/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "https-proxy-agent": "^9.1.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  },
  "private": true,
  "license": "MIT"
}
